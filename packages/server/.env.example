# Copy to .env for local development. npm run dev and the Prisma CLI read it.
DATABASE_URL=postgresql://aeolus:aeolus@127.0.0.1:5432/aeolus
# Where ships reach the fleet: the fleet URL every starting prompt carries. The public HTTPS URL in production.
PUBLIC_URL=http://127.0.0.1:4000
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# true only behind a reverse proxy (Caddy): the sign-in rate limit then counts per client address.
TRUST_PROXY=false
# The console's origin: sign-in, sign-out and every change made with the session cookie come only
# from it. Unset: PUBLIC_URL's origin, for web and server behind one host. In development the
# console runs on its own port and forwards /trpc here.
CONSOLE_ORIGIN=http://localhost:3000
# A console on another host under one domain (web and server on different hosts): the domain the
# session cookie is set for, and CONSOLE_ORIGIN as the console's origin, allowed to call with
# credentials. Every host under COOKIE_DOMAIN receives the session cookie, so pick the narrowest
# domain the two hosts share. The web app does not call a server on another host yet.
# COOKIE_DOMAIN=fleet.example.com
# CONSOLE_ORIGIN=https://console.fleet.example.com
