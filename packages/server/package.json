{
  "name": "@aeolus-fleet/server",
  "version": "0.0.0",
  "description": "Aeolus server: the tRPC API and the fleet domain on Postgres.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet.git",
    "directory": "packages/server"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "@aeolus-fleet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/adapters/prisma/schema.prisma",
    "src/adapters/prisma/migrations"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "tsx watch --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "fleet:init": "tsx --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/fleet-init.ts",
    "operator:reset-password": "tsx --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/operator-reset-password.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aeolus-fleet/common": "0.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@trpc/server": "^11.19.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@trpc/client": "^11.19.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15"
  }
}
