// Aeolus core tables (docs/architecture.md, "Core tables").
//
// Prefixed ids, fleet_id on every table except fleets, and the columns and key
// constraints named in the architecture. Columns a later slice owns (a message's
// sender and selector, for one) arrive with that slice.
//
// References to rows of the same fleet carry fleet_id in the foreign key, so a
// row can never point at another fleet's ship, lease, message or delivery.
//
// Timestamps have no database default: the application's Clock port sets every
// one of them, so tests control time.
//
// Check constraints and the append-only rule for events live in the migration
// SQL, because Prisma does not model them.

generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// The tenant: one operator's ships, messages and history. Ids start with flt_.
model Fleet {
  id        String   @id
  name      String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  ships           Ship[]
  leases          Lease[]
  credentials     Credential[]
  messages        Message[]
  deliveries      Delivery[]
  events          Event[]
  consoleSessions ConsoleSession[]
  operator        Operator?

  @@map("fleets")
}

/// `argo` is the one operator ship of a fleet; every other ship is an agent.
enum ShipKind {
  operator
  agent

  @@map("ship_kind")
}

/// A durable, addressable identity with an inbox. Ids start with shp_.
/// Scopes are set when the ship is created and checked before every call.
model Ship {
  id        String    @id
  fleetId   String    @map("fleet_id")
  name      String
  type      String
  kind      ShipKind
  scopes    String[]
  note      String?
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(3)

  fleet             Fleet            @relation(fields: [fleetId], references: [id])
  leases            Lease[]
  credentials       Credential[]
  deliveries        Delivery[]       @relation("DeliveryRecipientShip")
  claimedDeliveries Delivery[]       @relation("DeliveryClaimedByShip")
  consoleSessions   ConsoleSession[]
  actorOfEvents     Event[]          @relation("EventActorShip")
  events            Event[]          @relation("EventShip")

  @@unique([fleetId, id])
  /// A name is unique among ships that are not retired, and reusable after retirement.
  @@unique([fleetId, name], map: "ships_fleet_id_name_active_key", where: { retiredAt: null })
  /// Exactly one operator ship per fleet.
  @@unique([fleetId], map: "ships_fleet_id_operator_key", where: raw("kind = 'operator'::ship_kind"))
  @@map("ships")
}

/// Where the session crewing a ship runs. OTHER carries a description; the other kinds none.
enum LocationKind {
  DEVICE
  CLOUD
  SERVER
  OTHER

  @@map("location_kind")
}

/// The exclusive right of one session to crew a ship, and where that session runs.
/// Ids start with lse_.
/// The hash of the crew token register gave the session, unique across all fleets:
/// finding a ship by its crew token is a lookup not scoped by fleet (ADR 0007). A
/// console session's lease on argo has none; the console session holds its token.
model Lease {
  id                  String       @id
  fleetId             String       @map("fleet_id")
  shipId              String       @map("ship_id")
  location            LocationKind
  locationDescription String?      @map("location_description")
  crewTokenHash       String?      @unique @map("crew_token_hash")
  startedAt           DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt             DateTime?    @map("ended_at") @db.Timestamptz(3)

  fleet           Fleet            @relation(fields: [fleetId], references: [id])
  ship            Ship             @relation(fields: [fleetId, shipId], references: [fleetId, id])
  consoleSessions ConsoleSession[]

  @@unique([fleetId, id])
  /// At most one open lease per ship.
  @@unique([shipId], map: "leases_ship_id_open_key", where: { endedAt: null })
  @@map("leases")
}

/// A ship secret, stored only as its hash. Ids start with crd_.
/// The hash is unique across all fleets: finding a ship by its secret is the one
/// lookup not scoped by fleet (ADR 0007).
model Credential {
  id            String    @id
  fleetId       String    @map("fleet_id")
  shipId        String    @map("ship_id")
  secretHash    String    @unique @map("secret_hash")
  issuedAt      DateTime  @map("issued_at") @db.Timestamptz(3)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  fleet Fleet @relation(fields: [fleetId], references: [id])
  ship  Ship  @relation(fields: [fleetId, shipId], references: [fleetId, id])

  /// At most one valid secret per ship.
  @@unique([shipId], map: "credentials_ship_id_valid_key", where: { invalidatedAt: null })
  @@map("credentials")
}

/// An immutable envelope plus an opaque payload of at most 64 KB. Ids start with msg_.
/// It can name the message it replies to, and a resend names the message it resends.
/// Sender and selector arrive with slice 4 (send), together with the unique rule
/// on sender plus idempotency key.
model Message {
  id                 String   @id
  fleetId            String   @map("fleet_id")
  payload            String
  contentType        String   @map("content_type")
  idempotencyKey     String   @map("idempotency_key")
  inReplyToMessageId String?  @map("in_reply_to_message_id")
  resendOfMessageId  String?  @map("resend_of_message_id")
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)

  fleet      Fleet      @relation(fields: [fleetId], references: [id])
  inReplyTo  Message?   @relation("MessageInReplyTo", fields: [fleetId, inReplyToMessageId], references: [fleetId, id], onDelete: Restrict)
  replies    Message[]  @relation("MessageInReplyTo")
  resendOf   Message?   @relation("MessageResendOf", fields: [fleetId, resendOfMessageId], references: [fleetId, id], onDelete: Restrict)
  resends    Message[]  @relation("MessageResendOf")
  deliveries Delivery[]
  events     Event[]

  @@unique([fleetId, id])
  @@map("messages")
}

enum DeliveryState {
  pending
  delivered
  acknowledged
  undeliverable
  dismissed
  abandoned

  @@map("delivery_state")
}

/// One message to one resolved recipient: a ship or a type. Ids start with dlv_.
/// The read date is set when the operator opens a message to argo.
model Delivery {
  id              String        @id
  fleetId         String        @map("fleet_id")
  messageId       String        @map("message_id")
  recipientShipId String?       @map("recipient_ship_id")
  recipientType   String?       @map("recipient_type")
  state           DeliveryState @default(pending)
  claimedByShipId String?       @map("claimed_by_ship_id")
  attempts        Int           @default(0)
  readAt          DateTime?     @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime      @map("created_at") @db.Timestamptz(3)

  fleet         Fleet   @relation(fields: [fleetId], references: [id])
  message       Message @relation(fields: [fleetId, messageId], references: [fleetId, id])
  recipientShip Ship?   @relation("DeliveryRecipientShip", fields: [fleetId, recipientShipId], references: [fleetId, id], onDelete: Restrict)
  claimedByShip Ship?   @relation("DeliveryClaimedByShip", fields: [fleetId, claimedByShipId], references: [fleetId, id], onDelete: Restrict)
  events        Event[]

  @@unique([fleetId, id])
  /// One row per recipient.
  @@unique([messageId, recipientShipId])
  @@unique([messageId, recipientType])
  @@index([fleetId, recipientShipId, state])
  @@index([fleetId, recipientType, state])
  @@map("deliveries")
}

/// Append-only log of every state change: never updated or deleted. Ids start with evt_.
/// Records its type and time, who caused it (a ship, or the system when
/// actor_ship_id is null), the ship, message and delivery it concerns, and a few
/// details as a flat JSON object.
model Event {
  id          String   @id
  fleetId     String   @map("fleet_id")
  type        String
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  actorShipId String?  @map("actor_ship_id")
  shipId      String?  @map("ship_id")
  messageId   String?  @map("message_id")
  deliveryId  String?  @map("delivery_id")
  details     Json

  fleet     Fleet     @relation(fields: [fleetId], references: [id])
  actorShip Ship?     @relation("EventActorShip", fields: [fleetId, actorShipId], references: [fleetId, id], onDelete: Restrict)
  ship      Ship?     @relation("EventShip", fields: [fleetId, shipId], references: [fleetId, id], onDelete: Restrict)
  message   Message?  @relation(fields: [fleetId, messageId], references: [fleetId, id], onDelete: Restrict)
  delivery  Delivery? @relation(fields: [fleetId, deliveryId], references: [fleetId, id], onDelete: Restrict)

  @@map("events")
}

/// The operator's login: email and Argon2id password hash. Ids start with opr_.
/// The email is unique across all fleets: finding the account by email is the one
/// lookup not scoped by fleet (ADR 0007). One account per fleet in v1.
model Operator {
  id           String   @id
  fleetId      String   @unique @map("fleet_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)

  fleet Fleet @relation(fields: [fleetId], references: [id])

  @@map("operators")
}

/// The operator crewing argo through the web console. Ids start with ses_.
/// Only the hash of the session token is stored, unique across all fleets: finding
/// a session by its token is the one lookup not scoped by fleet (ADR 0007).
/// Valid until expires_at, which moves to 30 days after each use.
model ConsoleSession {
  id         String    @id
  fleetId    String    @map("fleet_id")
  shipId     String    @map("ship_id")
  leaseId    String    @map("lease_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)

  fleet Fleet @relation(fields: [fleetId], references: [id])
  ship  Ship  @relation(fields: [fleetId, shipId], references: [fleetId, id])
  lease Lease @relation(fields: [fleetId, leaseId], references: [fleetId, id])

  /// At most one live session per fleet: signing in ends the previous one.
  @@unique([fleetId], map: "console_sessions_fleet_id_open_key", where: { endedAt: null })
  @@map("console_sessions")
}
