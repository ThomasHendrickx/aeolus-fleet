{
  "name": "@aeolus-fleet/core",
  "version": "0.0.0",
  "description": "Aeolus server: the tRPC API and the fleet domain on Postgres.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "@aeolus-fleet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aeolus-core": "dist/bin/aeolus-core.js"
  },
  "files": [
    "dist",
    "prisma.config.ts",
    "src/adapters/prisma/schema.prisma",
    "src/adapters/prisma/migrations"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "dev": "tsx watch --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/aeolus-core.ts start",
    "start": "node dist/bin/aeolus-core.js start",
    "aeolus-core": "tsx --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/aeolus-core.ts",
    "fleet:init": "tsx --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/aeolus-core.ts fleet:init",
    "operator:reset-password": "tsx --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/aeolus-core.ts operator:reset-password",
    "db:migrate": "tsx --conditions=@aeolus-fleet/source --env-file-if-exists=.env src/bin/aeolus-core.ts migrate",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm LICENSE"
  },
  "dependencies": {
    "@aeolus-fleet/common": "0.0.0",
    "@fastify/websocket": "^11.3.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/fastify-api-reference": "^1.72.4",
    "@trpc/server": "^11.19.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@trpc/client": "^11.19.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
