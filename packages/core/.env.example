# Copy to .env for local development. npm run dev, the npm run commands and the Prisma CLI read it.
# An installed aeolus-core reads its environment only.
DATABASE_URL=postgresql://aeolus:aeolus@127.0.0.1:5432/aeolus
# Where ships reach the fleet: every starting prompt carries the fleet MCP URL under it (<PUBLIC_URL>/mcp).
# The public HTTPS URL in production.
PUBLIC_URL=http://127.0.0.1:4000
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# true only behind a reverse proxy (Caddy): the sign-in and failed-register rate limits then count per client
# address. Without it, every client behind the proxy shares one budget.
TRUST_PROXY=false
# The console's origin: sign-in, sign-out and every change made with the session cookie come only
# from it. In development the console runs on its own port, and the browser calls /trpc here. In production
# leave it unset when web and server share PUBLIC_URL's host (the default), or set it to the
# console's origin, such as https://console.fleet.example.com, when the console runs on another host.
CONSOLE_ORIGIN=http://localhost:3000
# A console on another host under one domain (web and server on different hosts): the domain the
# session cookie is set for, with CONSOLE_ORIGIN set to the console's origin, allowed to call with
# credentials. Every host under COOKIE_DOMAIN receives the session cookie, so pick the narrowest
# domain the two hosts share.
# COOKIE_DOMAIN=fleet.example.com
