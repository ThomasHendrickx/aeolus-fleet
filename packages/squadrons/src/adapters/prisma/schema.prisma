// The squadrons tables, in squadrons' own database (decision 0017): the fleet's
// server never reads them, and squadrons never reads the fleet's tables; it
// reaches the fleet only through its public API, as the ship it crews.
//
// Timestamps have no database default: the application's Clock port sets every
// one of them, so tests control time.

generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// The crew token squadrons holds for each fleet's management ship, so a restart
/// crews it again without a new secret. One row per fleet: one install serves many fleets.
model ManagementCrew {
  fleetId   String   @id @map("fleet_id")
  shipId    String   @map("ship_id")
  shipName  String   @map("ship_name")
  /// Null while squadrons is not connected: the fleet and ship stay, as the last connection.
  crewToken String?  @map("crew_token")
  crewedAt  DateTime @map("crewed_at") @db.Timestamptz(3)

  @@map("management_crew")
}

/// A squadron (#79): the blueprint and templates it formed from, kept as they
/// were then, its state, and its flagship, whose crew token squadrons holds.
model Squadron {
  fleetId           String    @map("fleet_id")
  id                String
  state             String
  blueprint         Json
  templates         Json
  flagshipShipId    String    @map("flagship_ship_id")
  flagshipName      String    @map("flagship_name")
  flagshipCrewToken String    @map("flagship_crew_token")
  formedAt          DateTime  @map("formed_at") @db.Timestamptz(3)
  sailedAt          DateTime? @map("sailed_at") @db.Timestamptz(3)
  members           Member[]

  @@id([fleetId, id])
  @@map("squadrons")
}

/// A member: a ship of the fleet and its role in its squadron.
model Member {
  fleetId     String    @map("fleet_id")
  shipId      String    @id @map("ship_id")
  squadronId  String    @map("squadron_id")
  position    Int
  name        String
  role        String
  type        String
  onStationAt DateTime? @map("on_station_at") @db.Timestamptz(3)
  /// Its last check-in, and the model it stated then (null when it stated none).
  checkInAt    DateTime? @map("check_in_at") @db.Timestamptz(3)
  checkInModel String?   @map("check_in_model")
  /// The stand-down its flagship sent it once its squadron stood down; null before.
  standDownMessageId String?   @map("stand_down_message_id")
  /// When it sent its flagship stood-down; null before.
  stoodDownAt        DateTime? @map("stood_down_at") @db.Timestamptz(3)
  /// When squadrons retired its ship; null while it serves.
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz(3)
  /// When squadrons removed its crew request: it stands down until its crew is released (#343); null before.
  releasingSince     DateTime? @map("releasing_since") @db.Timestamptz(3)
  squadron    Squadron  @relation(fields: [fleetId, squadronId], references: [fleetId, id])

  @@index([fleetId, squadronId])
  @@map("members")
}

/// A message a flagship received and does not handle: acknowledged and kept, so
/// none disappears, for the squadron page.
model FlagshipMessage {
  fleetId      String   @map("fleet_id")
  deliveryId   String   @id @map("delivery_id")
  squadronId   String   @map("squadron_id")
  messageId    String   @map("message_id")
  senderShipId String   @map("sender_ship_id")
  senderName   String   @map("sender_name")
  contentType  String   @map("content_type")
  payload      String
  inReplyTo    String?  @map("in_reply_to")
  receivedAt   DateTime @map("received_at") @db.Timestamptz(3)

  @@index([fleetId, squadronId, receivedAt])
  @@map("flagship_messages")
}

/// A forming in progress, recorded before forming changes the fleet: its ships by
/// name, and their ids once commissioned. A start after a crash retires what an
/// unfinished one commissioned.
model FormationAttempt {
  id         String    @id
  fleetId    String    @map("fleet_id")
  squadronId String    @map("squadron_id")
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  ships      FormationShip[]

  @@index([fleetId, finishedAt])
  @@map("formation_attempts")
}

/// A ship a formation attempt was about to commission, and its id once it did.
model FormationShip {
  attemptId String           @map("attempt_id")
  name      String
  fleetId   String           @map("fleet_id")
  shipId    String?          @map("ship_id")
  position  Int
  attempt   FormationAttempt @relation(fields: [attemptId], references: [id])

  @@id([attemptId, name])
  @@map("formation_ships")
}

/// A git repository the operator set in the console to read templates and
/// blueprints from (#161): runtime configuration, never a file. The read token
/// is written once and never shown; it is kept as squadrons keeps its crew
/// tokens until #104 decides how secrets are stored at rest.
model TemplateRepository {
  fleetId        String    @map("fleet_id")
  /// What blueprints reference it by: its URL without the scheme and `.git`.
  name           String
  url            String
  path           String
  token          String?
  addedAt        DateTime  @map("added_at") @db.Timestamptz(3)
  lastFetchedAt  DateTime? @map("last_fetched_at") @db.Timestamptz(3)
  /// Why its last fetch failed; null when it worked or before the first.
  lastFetchError String?   @map("last_fetch_error")

  @@id([fleetId, name])
  @@map("template_repositories")
}

/// Each fleet's switch, as the hosting service set it through the installation
/// procedures (decision 0021). Read only when squadrons has an installation token.
model FleetSwitch {
  fleetId   String   @id @map("fleet_id")
  enabled   Boolean
  changedAt DateTime @map("changed_at") @db.Timestamptz(3)

  @@map("fleet_switches")
}

/// The installation's requests, by the caller's request id, so a replay answers
/// what the first call answered. A switch names its fleet and goes with it; a
/// delete keeps only the request's hash, so nothing of the deleted fleet stays.
model InstallationRequest {
  requestId   String   @id @map("request_id")
  kind        String
  requestHash String   @map("request_hash")
  fleetId     String?  @map("fleet_id")
  enabled     Boolean?
  at          DateTime @db.Timestamptz(3)

  @@index([fleetId])
  @@map("installation_requests")
}
