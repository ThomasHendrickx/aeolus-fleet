{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2024", "esnext.temporal"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // The build scripts run under plain Node.js, which imports a script by its .ts name.
    "allowImportingTsExtensions": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".storybook/*.ts", ".storybook/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next/cache"]
}
