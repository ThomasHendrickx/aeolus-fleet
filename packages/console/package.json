{
  "name": "@aeolus-fleet/console",
  "version": "0.0.0",
  "description": "The Aeolus console: see every ship, answer your agents and manage the fleet from any device.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "dashboard",
    "fleet",
    "self-hosted"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet.git",
    "directory": "packages/console"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "aeolus-console": "bin/aeolus-console.js"
  },
  "files": [
    "bin",
    ".next/standalone",
    "!.next/standalone/**/*.map"
  ],
  "scripts": {
    "predev": "npm run build --workspace @aeolus-fleet/common --workspace @aeolus-fleet/ui",
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/standalone.ts",
    "start": "node bin/aeolus-console.js start",
    "typecheck": "next typegen && tsc --project tsconfig.json",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm LICENSE"
  },
  "devDependencies": {
    "@aeolus-fleet/common": "0.0.0",
    "@aeolus-fleet/core": "0.0.0",
    "@aeolus-fleet/ui": "0.0.0",
    "@base-ui/react": "^1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "storybook": "^10.6.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
