+-- Authoritative declaration JSON maintains universal grants transactionally.
+-- Fixed renderer predicates must match these partial-index predicates exactly.
+CREATE INDEX declared_network_rules_person_read_universal_idx
+  ON declared_network_rules (fleet_id)
+  WHERE jsonb_path_exists(rules,
+    '$[*] ? (@.verb == "read" && @.from.size() == 0 && @.to.size() == 0)');
+CREATE INDEX declared_network_rules_person_send_universal_idx
+  ON declared_network_rules (fleet_id)
+  WHERE jsonb_path_exists(rules,
+    '$[*] ? (@.verb == "send" && @.from.size() == 0 && @.to.size() == 0)');
diff --git a/packages/core/src/adapters/prisma/person-declared-permission.ts b/packages/core/src/adapters/prisma/person-declared-permission.ts
new file mode 100644
index 000000000..d18467167
--- /dev/null
+++ b/packages/core/src/adapters/prisma/person-declared-permission.ts
@@ -0,0 +1,110 @@
+/** Fixed interpretation of authoritative declarations. Each candidate selects only
+ * its carried labels' definers; statement inputs cover from-only and universal grants.
+ */
+import type { FleetId } from '@aeolus-fleet/common';
+
+import type { DeclaredPermissionProgram, PersonPermissionPlan } from '../../domain/registry/person-permission.js';
+import { Prisma } from './generated/client.js';
+
+function names(program: DeclaredPermissionProgram) {
+  return program.verb === 'read'
+    ? { subject: Prisma.sql`read_subject`, installation: Prisma.sql`read_installation`, fixed: Prisma.sql`read_fixed` }
+    : { subject: Prisma.sql`send_subject`, installation: Prisma.sql`send_installation`, fixed: Prisma.sql`send_fixed` };
+}
+
+export function personDeclaredInputs(fleetId: FleetId, plans: readonly PersonPermissionPlan[]): Prisma.Sql[] {
+  return plans.flatMap((plan) => {
+    const program = plan.declared;
+    if (plan.isEvery || program === undefined) { return []; }
+    const own = names(program);
+    const labels = JSON.stringify(program.labels);
+    const universal = program.verb === 'read'
+      ? Prisma.sql`jsonb_path_exists(rules, '$[*] ? (@.verb == "read" && @.from.size() == 0 && @.to.size() == 0)')`
+      : Prisma.sql`jsonb_path_exists(rules, '$[*] ? (@.verb == "send" && @.from.size() == 0 && @.to.size() == 0)')`;
+    return [Prisma.sql`${own.subject} AS MATERIALIZED (
+      SELECT DISTINCT label.owner_ship_id AS ship_id
+      FROM jsonb_to_recordset(${labels}::jsonb) AS held("labelId" text, "valueId" text)
+      JOIN labels label ON label.fleet_id = ${fleetId} AND label.id = held."labelId"
+      WHERE label.owner_kind = 'ship' AND label.owner_ship_id IS NOT NULL
+    )`, Prisma.sql`${own.installation} AS MATERIALIZED (
+      SELECT rules FROM installation_declared_network_rules WHERE fleet_id = ${fleetId}
+    )`, Prisma.sql`${own.fixed} AS MATERIALIZED (
+      SELECT EXISTS (SELECT 1 FROM declared_network_rules WHERE fleet_id = ${fleetId} AND ${universal} LIMIT 1)
+        OR EXISTS (
+          SELECT 1 FROM ${own.subject} definer
+          CROSS JOIN LATERAL (SELECT rules FROM declared_network_rules
+            WHERE fleet_id = ${fleetId} AND ship_id = definer.ship_id OFFSET 0) declaration
+          CROSS JOIN LATERAL jsonb_array_elements(declaration.rules) rule(doc)
+          WHERE rule.doc->>'verb' = ${program.verb}
+            AND jsonb_array_length(rule.doc->'to') = 0 AND jsonb_array_length(rule.doc->'from') > 0
+            AND ${selector(program, { side: 'from', isFixed: true })}
+        ) AS allows
+    )`];
+  });
+}
+
+export function personDeclaredPermissionSql(program: DeclaredPermissionProgram): Prisma.Sql {
+  const own = names(program);
+  return Prisma.sql`(
+    (SELECT allows FROM ${own.fixed})
+    OR EXISTS (
+      SELECT 1 FROM ${own.installation} declaration
+      CROSS JOIN LATERAL jsonb_array_elements(declaration.rules) rule(doc)
+      WHERE rule.doc->>'verb' = ${program.verb} AND ${selector(program, { side: 'from' })} AND ${selector(program, { side: 'to' })}
+    )
+    OR EXISTS (
+      SELECT 1 FROM (
+        SELECT DISTINCT label.owner_ship_id AS ship_id
+        FROM ship_labels held JOIN labels label ON label.fleet_id = held.fleet_id AND label.id = held.label_id
+        WHERE held.fleet_id = s.fleet_id AND held.ship_id = s.id
+          AND label.owner_kind = 'ship' AND label.owner_ship_id IS NOT NULL OFFSET 0
+      ) definer
+      CROSS JOIN LATERAL (
+        SELECT rules FROM declared_network_rules
+        WHERE fleet_id = s.fleet_id AND ship_id = definer.ship_id OFFSET 0
+      ) declaration
+      CROSS JOIN LATERAL jsonb_array_elements(declaration.rules) rule(doc)
+      WHERE rule.doc->>'verb' = ${program.verb} AND jsonb_array_length(rule.doc->'to') > 0
+        AND ${selector(program, { side: 'from' })} AND ${selector(program, { side: 'to' })}
+      OFFSET 0
+    )
+  )`;
+}
+
+function selector(program: DeclaredPermissionProgram, input: { side: 'from' | 'to'; isFixed?: boolean }): Prisma.Sql {
+  const { side, isFixed = false } = input;
+  const labels = JSON.stringify(program.labels);
+  const terms = side === 'from' ? Prisma.sql`rule.doc->'from'` : Prisma.sql`rule.doc->'to'`;
+  const selected = Prisma.sql`EXISTS (
+    SELECT 1 FROM jsonb_to_recordset(${labels}::jsonb) AS selected("labelId" text, "valueId" text)
+    WHERE CASE WHEN jsonb_typeof(term.doc) = 'string' THEN selected."valueId" = term.doc #>> '{}'
+      ELSE selected."labelId" = term.doc->>'labelId' END
+  )`;
+  const exact = side === 'from' ? selected : Prisma.sql`EXISTS (
+    SELECT 1 FROM ship_labels carried WHERE carried.fleet_id = s.fleet_id AND carried.ship_id = s.id
+      AND carried.value_id = term.doc #>> '{}' OFFSET 0
+  )`;
+  const any = side === 'from' ? selected : Prisma.sql`EXISTS (
+    SELECT 1 FROM ship_labels carried WHERE carried.fleet_id = s.fleet_id AND carried.ship_id = s.id
+      AND carried.label_id = term.doc->>'labelId' OFFSET 0
+  )`;
+  const same = Prisma.sql`EXISTS (
+    SELECT 1 FROM ship_labels carried WHERE carried.fleet_id = s.fleet_id AND carried.ship_id = s.id
+      AND carried.label_id = term.doc->>'labelId'
+      AND EXISTS (
+        SELECT 1 FROM jsonb_to_recordset(${labels}::jsonb) AS selected("labelId" text, "valueId" text)
+        WHERE selected."labelId" = carried.label_id AND selected."valueId" = carried.value_id
+      ) OFFSET 0
+  )`;
+  // A corrupt operation is a database decoding failure, never an empty successful read.
+  const invalid = Prisma.sql`(term.doc::text || ' invalid declared term')::boolean`;
+  return Prisma.sql`NOT EXISTS (
+    SELECT 1 FROM jsonb_array_elements(${terms}) term(doc)
+    WHERE NOT COALESCE(CASE
+      WHEN jsonb_typeof(term.doc) = 'string' THEN ${exact}
+      WHEN jsonb_typeof(term.doc) = 'object' AND term.doc->>'labelId' IS NOT NULL THEN
+        CASE term.doc->>'value' WHEN '*' THEN ${any} WHEN '#' THEN ${isFixed ? invalid : same} ELSE ${invalid} END
+      ELSE ${invalid}
+    END, false)
+  )`;
+}
