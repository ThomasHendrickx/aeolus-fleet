{
  "name": "aeolus-fleet",
  "private": true,
  "description": "Aeolus: an agent fleet manager. Workspace root for its published packages: common, core, console, squadrons, the trierarch plugin and the trierarch.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/common",
    "packages/core",
    "packages/squadrons",
    "packages/trierarch-plugin",
    "packages/trierarch",
    "packages/console"
  ],
  "scripts": {
    "postinstall": "npm run generate --workspace @aeolus-fleet/core --workspace @aeolus-fleet/squadrons --workspace @aeolus-fleet/trierarch-plugin",
    "build": "npm run build --workspace @aeolus-fleet/common --workspace @aeolus-fleet/core --workspace @aeolus-fleet/squadrons --workspace @aeolus-fleet/trierarch-plugin --workspace @aeolus-fleet/trierarch --workspace @aeolus-fleet/console",
    "typecheck": "tsc --project tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:unit": "vitest run --project '*:unit'",
    "test:integration": "vitest run --project '*:integration'",
    "test:e2e": "vitest run --project '*:e2e'",
    "test:stories": "vitest run --project '*:stories'",
    "set-version": "node scripts/set-version.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.7",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.23.0",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
